# Copy to .env locally or create a private equivalent outside version control.
# Generate and set a unique secret; never use this placeholder in production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Used for "collection date cannot be in the future"; set to where your farmers are.
DJANGO_TIME_ZONE=Asia/Kolkata
# Optional: use PostgreSQL instead of the local SQLite file (hosted deployments set this).
# DATABASE_URL=postgres://user:password@host:5432/dbname
